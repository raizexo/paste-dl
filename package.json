{
  "name": "yt-dlp-app",
  "version": "1.0.0",
  "description": "Paste a link, download. Minimal yt-dlp Electron app.",
  "main": "src/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "release": "electron-builder --win nsis --publish never && node scripts/release.js"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.example.ytdlp-app",
    "productName": "PasteDL",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin/",
        "to": "bin/"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "artifactName": "${productName}-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "raizexo",
        "repo": "paste-dl"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
